# 复制为 .env 后填写
# 档位：prototype（快速验证）/ local-prod（简历项目主力）/ enterprise（大厂生产）
TIER=local-prod

# 文档解析：docling（结构感知+表格+溯源）/ pymupdf（快速原型）
PARSER_BACKEND=docling

# Embedding：local（本地模型）或 api（OpenAI 兼容接口）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant passages that answer it

# Rerank
RERANK_ENABLED=true
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# LLM（DeepSeek 兼容 OpenAI 接口）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
