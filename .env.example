# 复制为 .env 后按需填写。改完用下面命令自检（应输出"配置一致"）：
#   .venv/bin/python -c "from app.config import validate_runtime; print(validate_runtime() or '配置一致')"

# ===== 原型档（默认，零依赖，开箱可跑）=====
# TIER 是名义档位，必须与下面各 BACKEND 实际实现一致，否则 validate_runtime() 会报"档位不一致"。
TIER=prototype
PARSER_BACKEND=pymupdf
EMBEDDING_BACKEND=deterministic
VECTORSTORE_BACKEND=memory
RERANK_BACKEND=deterministic
LLM_BACKEND=mock

# ===== 切到本地生产档（需先装重依赖）=====
# pip install 相关重依赖后，改成下面这组（TIER 必须一起改！）：
# TIER=local-prod
# PARSER_BACKEND=docling
# EMBEDDING_BACKEND=local
# VECTORSTORE_BACKEND=chroma
# RERANK_BACKEND=local
# LLM_BACKEND=api
# LLM_API_KEY=sk-your-key-here

# ===== Embedding =====
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant passages that answer it

# ===== Rerank =====
RERANK_ENABLED=true
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ===== LLM（DeepSeek 兼容 OpenAI 接口；mock 档可留空）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 安全（生产必须改！）=====
# JWT_SECRET=换成一段随机长字符串，别用默认的 dev-only-secret-change-me
# AUTH_ENABLED=true          # 默认 true，生产保持
# DEMO_TOKEN_ISSUER=false    # 生产必须关掉 demo 签发接口
